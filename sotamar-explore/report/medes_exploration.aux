\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Terrain analysis at the reported location of El Biotop artificial reef, Torredembarra. \textbf  {Top row:} depth, hillshade (5$\times $ vertical exaggeration), depth with 2\,m contours. \textbf  {Bottom row:} slope, fine BPI, VRM. The red cross marks the reported position. No structure is visible; the seafloor is uniformly smooth. Diagonal striping in the BPI panel reveals multibeam sonar survey-line artifacts.\relax }}{12}{figure.caption.13}\protected@file@percent }
\newlabel{fig:biotop}{{7}{12}{Terrain analysis at the reported location of El Biotop artificial reef, Torredembarra. \textbf {Top row:} depth, hillshade (5$\times $ vertical exaggeration), depth with 2\,m contours. \textbf {Bottom row:} slope, fine BPI, VRM. The red cross marks the reported position. No structure is visible; the seafloor is uniformly smooth. Diagonal striping in the BPI panel reveals multibeam sonar survey-line artifacts.\relax }{figure.caption.13}{}}
